# Nginx edge image (09-local-storage-and-nginx-spec.md,
# 04-containers-and-compose.md): pinned upstream Nginx + platform config; the
# frontend build output is baked in (prod contract: SPA + MFE assets + /media/*
# are served by the same edge). Build context is the REPO ROOT (the build stage
# consumes the npm workspaces: `web/` shell, `mfe/*` verticals, `packages/*`).
# No object-store tooling exists anywhere.
FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS spa
WORKDIR /src
# npm workspaces: every manifest first for layer caching — add each new MFE here.
COPY package.json package-lock.json ./
COPY web/package.json web/package.json
COPY mfe/account/package.json mfe/account/package.json
COPY mfe/domains/package.json mfe/domains/package.json
COPY packages/mfe-kit/package.json packages/mfe-kit/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci
COPY web/ web/
COPY mfe/ mfe/
COPY plans-claims.json plans-claims.json
COPY packages/ packages/
COPY scripts/ scripts/
RUN npm run build:web

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runtime
# openssl backs the dev self-signed certificate fallback; prod mounts real certs.
RUN apk add --no-cache openssl
COPY deploy/edge/nginx.conf /etc/nginx/nginx.conf
COPY deploy/edge/default.conf /etc/nginx/conf.d/default.conf
COPY deploy/edge/locations.conf /etc/nginx/edge/locations.conf
COPY deploy/edge/security-headers.conf /etc/nginx/edge/security-headers.conf
COPY deploy/edge/proxy-headers.conf /etc/nginx/edge/proxy-headers.conf
COPY deploy/edge/dev-certs.sh /docker-entrypoint.d/40-dev-certs.sh
RUN chmod +x /docker-entrypoint.d/40-dev-certs.sh
COPY --from=spa /src/web/dist /usr/share/nginx/html/app
EXPOSE 80 443
