{
  "name": "resume-builder-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playwright end-to-end suite for the compose stack, through the edge (same entry as deploy/smoke.sh).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "HEADED=1 SLOWMO=400 playwright test",
    "test:full": "E2E_FULL_LOGIN=1 playwright test 01-account-and-access.spec.ts 01-account-and-access.full-login.spec.ts",
    "test:headed:full": "E2E_FULL_LOGIN=1 HEADED=1 SLOWMO=400 playwright test 01-account-and-access.spec.ts 01-account-and-access.full-login.spec.ts",
    "test:auth": "E2E_FULL_LOGIN=1 playwright test 01-account-and-access.authenticated.spec.ts",
    "test:headed:auth": "E2E_FULL_LOGIN=1 HEADED=1 SLOWMO=400 playwright test 01-account-and-access.authenticated.spec.ts",
    "test:deletion": "E2E_FULL_LOGIN=1 playwright test 02-account-deletion.authenticated.spec.ts",
    "test:headed:deletion": "E2E_FULL_LOGIN=1 HEADED=1 SLOWMO=400 playwright test 02-account-deletion.authenticated.spec.ts",
    "test:plan": "E2E_FULL_LOGIN=1 playwright test 03-tier-presentation.authenticated.spec.ts",
    "test:headed:plan": "E2E_FULL_LOGIN=1 HEADED=1 SLOWMO=400 playwright test 03-tier-presentation.authenticated.spec.ts",
    "test:domains": "E2E_FULL_LOGIN=1 playwright test 04-custom-domains.authenticated.spec.ts",
    "test:headed:domains": "E2E_FULL_LOGIN=1 HEADED=1 SLOWMO=400 playwright test 04-custom-domains.authenticated.spec.ts",
    "test:domains-pro": "E2E_FULL_LOGIN=1 E2E_DOMAINS_PRO=1 playwright test 04-custom-domains.pro.spec.ts",
    "test:headed:domains-pro": "E2E_FULL_LOGIN=1 E2E_DOMAINS_PRO=1 HEADED=1 SLOWMO=400 playwright test 04-custom-domains.pro.spec.ts",
    "domains:on": "sh scripts/enable-domains-pro.sh",
    "domains:off": "sh scripts/disable-domains-pro.sh",
    "test:concierge": "E2E_FULL_LOGIN=1 E2E_CONCIERGE=1 E2E_CONCIERGE_RUN=$(date +%s)-$$ playwright test 05-concierge-managed-service.authenticated.spec.ts",
    "test:headed:concierge": "E2E_FULL_LOGIN=1 E2E_CONCIERGE=1 E2E_CONCIERGE_RUN=$(date +%s)-$$ HEADED=1 SLOWMO=400 playwright test 05-concierge-managed-service.authenticated.spec.ts",
    "concierge:on": "sh scripts/enable-concierge.sh",
    "concierge:off": "sh scripts/disable-concierge.sh",
    "idp:on": "sh scripts/enable-full-login.sh",
    "idp:off": "sh scripts/disable-full-login.sh",
    "idp:serve": "node mock-idp/server.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
