<configuration>
  <!-- Observability contract: JSON logs to stdout only (no file sinks).
       Fields: route, status, timing, trace id. Never payloads, PII, or money values. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeContext>false</includeContext>
      <customFields>{"service":"profile-service"}</customFields>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
