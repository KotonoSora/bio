# Platform env template. Copy to repo-root .env for local boot:
#   cp deploy/.env.example .env
# Real .env / compose overrides / secrets are NEVER committed (CI grep gate).
# Baseline: 04-containers-and-compose.md + 08-security-baseline.md

# --- Data root (host state: postgres/redis/uploads/logs/edge; never committed) ---
DATA_ROOT=./data

# --- Edge ports (Nginx; override 8880/8443 for rootless Podman parity) ---
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# --- Infra ports ---
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Infra credentials (dev-only defaults; override via vault in staging/prod) ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_only
POSTGRES_DB=platform

# --- Service host ports (override to resolve conflicts; services never hard-code) ---
GATEWAY_PORT=8080
ACCOUNT_PORT=8081
PROFILE_PORT=8082
LINK_PORT=8083
PUBLIC_SITE_PORT=8084
ANALYTICS_PORT=8085
RESUME_PORT=8086
SHOP_PORT=8087
BILLING_PORT=8088
PUBLISH_PORT=8089
WEB_PORT=8090

# --- Per-service app DB users (migrator vs app roles are wired in service configs) ---
ACCOUNT_DB_USER=account_app
ACCOUNT_DB_PASSWORD=account_dev_only
PROFILE_DB_USER=profile_app
PROFILE_DB_PASSWORD=profile_dev_only
LINK_DB_USER=link_app
LINK_DB_PASSWORD=link_dev_only
PUBLIC_SITE_DB_USER=public_site_app
PUBLIC_SITE_DB_PASSWORD=public_site_dev_only
ANALYTICS_DB_USER=analytics_app
ANALYTICS_DB_PASSWORD=analytics_dev_only
RESUME_DB_USER=resume_app
RESUME_DB_PASSWORD=resume_dev_only
SHOP_DB_USER=shop_app
SHOP_DB_PASSWORD=shop_dev_only
BILLING_DB_USER=billing_app
BILLING_DB_PASSWORD=billing_dev_only
PUBLISH_DB_USER=publish_app
PUBLISH_DB_PASSWORD=publish_dev_only

# --- Gateway identity (internal JWT RS256, 60s TTL, aud=<service>) ---
# Dev-only: leave empty to auto-generate an ephemeral key at boot (logged, never in prod).
INTERNAL_JWT_PRIVATE_KEY_PEM=
# Service-side verification hook (blank = dev-user branch; never blank in prod).
INTERNAL_JWT_PUBLIC_KEY_PEM=
INTERNAL_JWT_KID=e0-dev-key
# Previous public key during rotation (old verifies until expiry, new signs).
INTERNAL_JWT_PREVIOUS_PUBLIC_KEY_PEM=
# Outbound mesh credential for /internal/v1 calls (blank = dev, no header sent).
MESH_JWT_PRIVATE_KEY_PEM=
# Recovery invitation signing key (blank = dev placeholder).
RECOVERY_SIGNING_KEY=
SESSION_COOKIE_NAME=__Host-rb_session

# --- SSO providers (terminated by account-service; empty = provider hidden) ---
# Dev placeholders below keep the G3 login smoke meaningful without real IdPs;
# staging/production values arrive from vault, never from this file.
OAUTH_REDIRECT_BASE_URL=http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GENERIC_OIDC_ENABLED=true
GENERIC_OIDC_LABEL=Dev SSO
GENERIC_OIDC_CLIENT_ID=dev-smoke-client
GENERIC_OIDC_CLIENT_SECRET=
GENERIC_OIDC_AUTHORIZE_URI=https://idp.invalid/authorize
GENERIC_OIDC_TOKEN_URI=https://idp.invalid/token
GENERIC_OIDC_USERINFO_URI=
GENERIC_OIDC_JWK_SET_URI=
GENERIC_OIDC_ISSUER=

# --- Abuse control (Turnstile-class challenge at the gateway) ---
TURNSTILE_SECRET=

# --- Observability (OTel export; empty = disabled locally) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Read replicas (lag-aware routing; blank = primary-only) ---
LINK_REPLICA_DATASOURCE_URL=
LINK_REPLICA_DATASOURCE_USERNAME=link_app
LINK_REPLICA_DATASOURCE_PASSWORD=link_app_dev_only
ANALYTICS_REPLICA_DATASOURCE_URL=
ANALYTICS_REPLICA_DATASOURCE_USERNAME=analytics_app
ANALYTICS_REPLICA_DATASOURCE_PASSWORD=analytics_app_dev_only

# --- Stream consumers (parallelism per stream; replicas add group members) ---
ANALYTICS_STREAM_CONSUMERS=worker-1

# --- Scale overlay LB entrypoints (base slice ports above stay the contract) ---
LB_PUBLIC_SITE_PORT=8184
LB_LINK_PORT=8183
LB_ANALYTICS_PORT=8185

# --- Service backstop (per-service Redis counters; Trigger: edge limiter down) ---
SERVICE_RATELIMIT_PER_MINUTE=120

# --- Act-as allowlist (concierge surfaces opt in; account classes deny) ---
ACT_AS_ALLOWED_PREFIXES=

# --- Webhook verification (per-provider secrets; blank = dev open) ---
WEBHOOK_TIMESTAMP_SKEW_SECONDS=300
WEBHOOK_IP_ALLOWLIST=
# Per-provider HMAC secrets: WEBHOOK_SECRETS_<PROVIDER>=... (e.g. STRIPE, PAYOS)

# --- Per-service migrator users + passwords (DDL role; dev-only defaults) ---
ACCOUNT_MIGRATOR_USER=account_migrator
PROFILE_MIGRATOR_USER=profile_migrator
LINK_MIGRATOR_USER=link_migrator
ANALYTICS_MIGRATOR_USER=analytics_migrator
RESUME_MIGRATOR_USER=resume_migrator
SHOP_MIGRATOR_USER=shop_migrator
BILLING_MIGRATOR_USER=billing_migrator
PUBLISH_MIGRATOR_USER=publish_migrator
ACCOUNT_MIGRATOR_PASSWORD=account_migrator_dev_only
PROFILE_MIGRATOR_PASSWORD=profile_migrator_dev_only
LINK_MIGRATOR_PASSWORD=link_migrator_dev_only
ANALYTICS_MIGRATOR_PASSWORD=analytics_migrator_dev_only
RESUME_MIGRATOR_PASSWORD=resume_migrator_dev_only
SHOP_MIGRATOR_PASSWORD=shop_migrator_dev_only
BILLING_MIGRATOR_PASSWORD=billing_migrator_dev_only
PUBLISH_MIGRATOR_PASSWORD=publish_migrator_dev_only
